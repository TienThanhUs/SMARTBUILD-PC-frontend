# Base URL the browser uses for API calls. Keep "/api/v1" in development so
# requests go through the Vite proxy; set a full URL for production builds,
# e.g. https://api.smartbuildpc.vn/api/v1
VITE_API_BASE_URL=/api/v1

# Spring Boot server the Vite dev proxy forwards /api to.
VITE_BACKEND_URL=http://localhost:8080
